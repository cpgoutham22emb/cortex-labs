```gitignore
# ==========================================
# CORTEX LABS — ROOT GITIGNORE
# Location: cortex-labs/.gitignore
# ==========================================


# ==========================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==========================================

# Environment files anywhere in the repository
.env
.env.*

# Allow safe environment templates to be committed
!.env.example
!.env.*.example


# ==========================================
# FRONTEND — NEXT.JS
# ==========================================

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example


# ==========================================
# BACKEND — DJANGO / PYTHON
# ==========================================

# Python virtual environments
backend/venv/
backend/.venv/

# Python cache directories at any backend depth
backend/**/__pycache__/

# Compiled Python files
backend/**/*.py[cod]

# Django generated files
backend/media/
backend/staticfiles/


# ==========================================
# LOCAL DATABASES
# ==========================================

# SQLite databases anywhere in the project
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm


# ==========================================
# IDE AND EDITOR
# ==========================================

.vscode/
.idea/


# ==========================================
# LOGS
# ==========================================

*.log


# ==========================================
# OPERATING SYSTEM FILES
# ==========================================

Thumbs.db
.DS_Store
```

# ==========================================
# LOCAL PROJECT STRUCTURE REPORT
# ==========================================
structure.txt
